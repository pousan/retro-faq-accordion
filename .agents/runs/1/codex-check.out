   133	                                : "inline-flex items-center gap-1 rounded-full border-2 border-[#141026] bg-[#6bf0d2] px-2.5 py-0.5 text-xs font-black text-[#141026]"
   134	                              : "inline-flex items-center rounded-xs border border-current/40 px-2 py-0.5 text-xs font-medium opacity-75"
   135	                          }
   136	                        >
   137	                          {isSelected
   138	                            ? `● 選択中 (${option.badgeText})`
   139	                            : option.badgeText}
   140	                        </span>
   141	                      </span>
   142	                      <span className="text-xs leading-relaxed opacity-85">
   143	                        {option.sublabel}
   144	                      </span>
   145	                    </span>
   146	                  </label>
   147	                );
   148	              })}
   149	            </div>
   150	          </fieldset>
   151	        </div>
   152	
   153	        <AccordionFaq
   154	          items={items}
   155	          title="カフェ向けホームページ制作 よくあるご質問"
   156	          instanceId={instanceId}
   157	          selectedId={selectedId}
   158	          onOpenChange={handleOpenChange}
   159	          highlight={highlight}
   160	          includeJsonLd={true}
   161	          theme={theme}
   162	        />
   163	
   164	        <section
   165	          aria-labelledby="inline-share-heading"
   166	          className={
   167	            isRetro
   168	              ? "faq-card rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] p-4 shadow-[4px_4px_0px_#3a2212] sm:p-6"
   169	              : "faq-card rounded-3xl border-[3px] border-[#141026] bg-[#ffffff] p-4 shadow-[5px_5px_0px_#141026] sm:p-6"
   170	          }
   171	        >
   172	          <div className="mb-3 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
   173	            <h2
   174	              id="inline-share-heading"
   175	              className="text-base font-bold sm:text-lg"
   176	            >
   177	              このFAQ表示を共有する
   178	            </h2>
   179	            <p className="text-xs opacity-85">
   180	              {selectedQuestion
   181	                ? `現在選択中の「Q${questionIndex}. ${selectedQuestion.question}」への直リンクを共有します`
   182	                : `現在のテーマ（${
   183	                    isRetro ? "昭和純喫茶・和レトロ" : "80s シティポップ"
   184	                  }）のFAQ一覧リンクを共有します`}
   185	            </p>
   186	          </div>
   187	
   188	          <ShareButtonGroup
   189	            url={shareUrl}
   190	            title={shareTitle}
   191	            text={shareText}
   192	            theme={theme}
   193	            statusIdPrefix="inline-share"
   194	          />
   195	        </section>
   196	      </div>
   197	
   198	      <MobileStickyShareBar
   199	        url={shareUrl}
   200	        title={shareTitle}
   201	        text={shareText}
   202	        theme={theme}
   203	        footerId={footerId}
   204	      />
   205	    </div>
   206	  );
   207	}
   208	
   209	export default FaqPreviewClient;
FILE: components/MobileStickyShareBar.tsx
     1	"use client";
     2	
     3	import { ShareButtonGroup } from "@/components/ShareButtonGroup";
     4	import { useStickyShareBar } from "@/hooks/useStickyShareBar";
     5	import type { MobileStickyShareBarProps } from "@/lib/faq-types";
     6	
     7	export function MobileStickyShareBar({
     8	  url,
     9	  title,
    10	  text,
    11	  theme,
    12	  footerId,
    13	}: MobileStickyShareBarProps) {
    14	  const {
    15	    barRef,
    16	    isRetreated,
    17	    footerOverlap,
    18	    barHeight,
    19	    handleFocusIn,
    20	    handleFocusOut,
    21	  } = useStickyShareBar(footerId);
    22	
    23	  const isRetro = theme === "retro";
    24	
    25	  return (
    26	    <>
    27	      <div
    28	        aria-hidden="true"
    29	        className="block w-full md:hidden"
    30	        style={{ height: `${barHeight}px` }}
    31	      />
    32	      <aside
    33	        ref={barRef}
    34	        aria-label="モバイル用クイック共有バー"
    35	        data-theme={theme}
    36	        inert={isRetreated ? true : undefined}
    37	        onFocus={handleFocusIn}
    38	        onBlur={handleFocusOut}
    39	        style={{
    40	          bottom: `${footerOverlap}px`,
    41	          transform: isRetreated ? "translateY(110%)" : "translateY(0)",
    42	          visibility: isRetreated ? "hidden" : "visible",
    43	        }}
    44	        className={`sticky-share-bar pb-safe fixed inset-x-0 z-40 block md:hidden ${
    45	          isRetro
    46	            ? "border-t-2 border-[#3a2212] bg-[#f6efe0]/95 text-[#28180d] shadow-[0_-3px_0_#3a2212]"
    47	            : "border-t-[3px] border-[#141026] bg-[#e4fbf4]/95 text-[#141026] shadow-[0_-4px_0_#141026]"
    48	        } backdrop-blur-xs`}
    49	      >
    50	        <div className="px-safe mx-auto max-w-3xl py-2.5">
    51	          <ShareButtonGroup
    52	            url={url}
    53	            title={title}
    54	            text={text}
    55	            theme={theme}
    56	            compact
    57	            statusIdPrefix="mobile-sticky"
    58	          />
    59	        </div>
    60	      </aside>
    61	    </>
    62	  );
    63	}
    64	
    65	export default MobileStickyShareBar;
