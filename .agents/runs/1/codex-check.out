    46	                    aria-hidden="true"
    47	                    className="faq-q-badge inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xs border-2 border-[#3a2212] bg-[#a82417] text-sm font-bold text-[#fffdf8]"
    48	                  >
    49	                    Q{qNumber}
    50	                  </span>
    51	                  <span className="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
    52	                    <span className="break-words text-base font-bold sm:text-lg">
    53	                      {item.question}
    54	                    </span>
    55	                    <span className="faq-category-badge inline-flex w-fit shrink-0 items-center rounded-xs border border-[#3a2212] bg-[#efe3ca] px-2.5 py-0.5 text-xs font-semibold">
