     1	"use client";
     2	
     3	import { useCallback, useEffect, useRef, useState } from "react";
     4	
     5	export interface StickyShareBarState {
     6	  hiddenByScroll: boolean;
     7	  hiddenByKeyboard: boolean;
     8	  hiddenAboveViewport: boolean;
     9	  footerOverlap: number;
    10	  barHeight: number;
    11	  hasFocusWithin: boolean;
    12	}
    13	
    14	const DIRECTION_THRESHOLD_PX = 12;
    15	const TOP_REVEAL_THRESHOLD_PX = 24;
    16	const KEYBOARD_HEIGHT_THRESHOLD_PX = 140;
    17	
    18	export function useStickyShareBar(footerId: string) {
    19	  const barRef = useRef<HTMLElement | null>(null);
    20	  const [state, setState] = useState<StickyShareBarState>({
    21	    hiddenByScroll: false,
    22	    hiddenByKeyboard: false,
    23	    hiddenAboveViewport: false,
    24	    footerOverlap: 0,
    25	    barHeight: 72,
    26	    hasFocusWithin: false,
    27	  });
    28	
    29	  const lastScrollYRef = useRef<number>(0);
    30	  const directionRef = useRef<"up" | "down" | null>(null);
    31	  const accumulatedDeltaRef = useRef<number>(0);
    32	  const footerNearRef = useRef<boolean>(false);
    33	  const hasFocusWithinRef = useRef<boolean>(false);
    34	  const rafIdRef = useRef<number | null>(null);
    35	
    36	  const updateStateIfChanged = useCallback(
    37	    (partial: Partial<StickyShareBarState>) => {
    38	      setState((prev) => {
    39	        let changed = false;
    40	        const next: StickyShareBarState = { ...prev };
    41	        (Object.keys(partial) as Array<keyof StickyShareBarState>).forEach(
    42	          (key) => {
    43	            const val = partial[key];
    44	            if (val !== undefined && prev[key] !== val) {
    45	              // eslint-disable-next-line @typescript-eslint/no-explicit-any
    46	              (next as any)[key] = val;
    47	              changed = true;
    48	            }
    49	          }
    50	        );
    51	        return changed ? next : prev;
    52	      });
    53	    },
    54	    []
    55	  );
    56	
    57	  const handleFocusIn = useCallback(() => {
    58	    hasFocusWithinRef.current = true;
    59	    updateStateIfChanged({
    60	      hasFocusWithin: true,
    61	      hiddenByScroll: false,
    62	      hiddenByKeyboard: false,
    63	    });
    64	  }, [updateStateIfChanged]);
    65	
    66	  const handleFocusOut = useCallback(
    67	    (event: React.FocusEvent<HTMLElement>) => {
    68	      const currentTarget = event.currentTarget;
    69	      const relatedTarget = event.relatedTarget as Node | null;
    70	      if (relatedTarget && currentTarget.contains(relatedTarget)) {
    71	        return;
    72	      }
    73	      hasFocusWithinRef.current = false;
    74	      updateStateIfChanged({
    75	        hasFocusWithin: false,
    76	      });
    77	    },
    78	    [updateStateIfChanged]
    79	  );
    80	
    81	  useEffect(() => {
    82	    if (typeof window === "undefined") {
    83	      return;
    84	    }
    85	
    86	    lastScrollYRef.current = Math.max(0, window.scrollY);
    87	
    88	    const measureAndSync = () => {
    89	      rafIdRef.current = null;
    90	
    91	      const currentScrollY = Math.max(0, window.scrollY);
    92	      const delta = currentScrollY - lastScrollYRef.current;
    93	      lastScrollYRef.current = currentScrollY;
    94	
    95	      let nextHiddenByScroll: boolean | undefined = undefined;
    96	
    97	      if (currentScrollY <= TOP_REVEAL_THRESHOLD_PX) {
    98	        directionRef.current = "up";
    99	        accumulatedDeltaRef.current = 0;
   100	        nextHiddenByScroll = false;
   101	      } else if (delta !== 0) {
   102	        const currentDirection: "up" | "down" = delta > 0 ? "down" : "up";
   103	        if (directionRef.current !== currentDirection) {
   104	          directionRef.current = currentDirection;
   105	          accumulatedDeltaRef.current = Math.abs(delta);
   106	        } else {
   107	          accumulatedDeltaRef.current += Math.abs(delta);
   108	        }
   109	
   110	        if (accumulatedDeltaRef.current >= DIRECTION_THRESHOLD_PX) {
   111	          if (currentDirection === "down" && !hasFocusWithinRef.current) {
   112	            nextHiddenByScroll = true;
   113	          } else if (currentDirection === "up") {
   114	            nextHiddenByScroll = false;
   115	          }
   116	        }
   117	      }
   118	
   119	      if (hasFocusWithinRef.current) {
   120	        nextHiddenByScroll = false;
   121	      }
   122	
   123	      let nextFooterOverlap = 0;
   124	      let nextHiddenAboveViewport = false;
   125	      const footerEl = document.getElementById(footerId);
   126	
   127	      if (footerEl) {
   128	        const footerRect = footerEl.getBoundingClientRect();
   129	        const viewportBottom = window.innerHeight;
   130	        if (footerRect.top < viewportBottom) {
   131	          footerNearRef.current = true;
   132	        }
   133	        if (footerNearRef.current) {
   134	          const overlap = Math.max(
   135	            0,
   136	            Math.round(viewportBottom - footerRect.top)
   137	          );
   138	          nextFooterOverlap = overlap;
   139	          const barH = barRef.current?.offsetHeight ?? 72;
   140	          if (footerRect.top <= barH && !hasFocusWithinRef.current) {
   141	            nextHiddenAboveViewport = true;
   142	          }
   143	        }
   144	      }
   145	
   146	      let nextHiddenByKeyboard = false;
   147	      if (window.visualViewport && !hasFocusWithinRef.current) {
   148	        const keyboardDiff =
   149	          window.innerHeight - window.visualViewport.height;
   150	        if (keyboardDiff > KEYBOARD_HEIGHT_THRESHOLD_PX) {
   151	          nextHiddenByKeyboard = true;
   152	        }
   153	      }
   154	
   155	      const partialUpdate: Partial<StickyShareBarState> = {
   156	        footerOverlap: nextFooterOverlap,
   157	        hiddenAboveViewport: nextHiddenAboveViewport,
   158	        hiddenByKeyboard: nextHiddenByKeyboard,
   159	      };
   160	      if (nextHiddenByScroll !== undefined) {
   161	        partialUpdate.hiddenByScroll = nextHiddenByScroll;
   162	      }
   163	
   164	      updateStateIfChanged(partialUpdate);
   165	    };
   166	
   167	    const scheduleSync = () => {
   168	      if (rafIdRef.current !== null) {
   169	        return;
   170	      }
   171	      rafIdRef.current = window.requestAnimationFrame(measureAndSync);
   172	    };
   173	
   174	    const footerEl = document.getElementById(footerId);
   175	    const sentinelEl =
   176	      document.getElementById(`${footerId}-sentinel`) ?? footerEl;
   177	
   178	    let intersectionObserver: IntersectionObserver | null = null;
   179	    if (typeof IntersectionObserver !== "undefined" && sentinelEl) {
   180	      intersectionObserver = new IntersectionObserver(
   181	        (entries) => {
   182	          for (const entry of entries) {
   183	            footerNearRef.current =
   184	              entry.isIntersecting ||
   185	              entry.boundingClientRect.top < window.innerHeight;
   186	          }
   187	          scheduleSync();
   188	        },
   189	        {
   190	          root: null,
   191	          rootMargin: "0px 0px 160px 0px",
   192	          threshold: [0, 0.01, 0.5, 1],
   193	        }
   194	      );
   195	      intersectionObserver.observe(sentinelEl);
   196	    }
   197	
   198	    let resizeObserver: ResizeObserver | null = null;
   199	    if (typeof ResizeObserver !== "undefined" && barRef.current) {
   200	      resizeObserver = new ResizeObserver((entries) => {
   201	        for (const entry of entries) {
   202	          const target = entry.target as HTMLElement;
   203	          const measured = Math.ceil(target.offsetHeight);
   204	          if (measured > 0) {
   205	            updateStateIfChanged({ barHeight: measured });
   206	          }
   207	        }
   208	        scheduleSync();
   209	      });
   210	      resizeObserver.observe(barRef.current);
   211	    }
   212	
   213	    window.addEventListener("scroll", scheduleSync, { passive: true });
   214	    window.addEventListener("resize", scheduleSync, { passive: true });
   215	
   216	    const vv = window.visualViewport;
   217	    if (vv) {
   218	      vv.addEventListener("resize", scheduleSync, { passive: true });
   219	      vv.addEventListener("scroll", scheduleSync, { passive: true });
   220	    }
   221	
   222	    scheduleSync();
   223	
   224	    return () => {
   225	      window.removeEventListener("scroll", scheduleSync);
   226	      window.removeEventListener("resize", scheduleSync);
   227	      if (vv) {
   228	        vv.removeEventListener("resize", scheduleSync);
   229	        vv.removeEventListener("scroll", scheduleSync);
   230	      }
   231	      if (intersectionObserver) {
   232	        intersectionObserver.disconnect();
   233	      }
   234	      if (resizeObserver) {
   235	        resizeObserver.disconnect();
   236	      }
   237	      if (rafIdRef.current !== null) {
   238	        window.cancelAnimationFrame(rafIdRef.current);
   239	        rafIdRef.current = null;
   240	      }
   241	    };
   242	  }, [footerId, updateStateIfChanged]);
   243	
   244	  const isRetreated =
   245	    !state.hasFocusWithin &&
   246	    (state.hiddenByScroll ||
   247	      state.hiddenByKeyboard ||
   248	      state.hiddenAboveViewport);
   249	
   250	  return {
   251	    barRef,
   252	    isRetreated,
   253	    footerOverlap: state.footerOverlap,
   254	    barHeight: state.barHeight,
   255	    handleFocusIn,
   256	    handleFocusOut,
   257	  };
   258	}
