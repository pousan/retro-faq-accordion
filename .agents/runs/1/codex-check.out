   181	              ? "inline-flex items-center rounded-xs border border-[#3a2212] bg-[#efe3ca] px-3 py-1 text-xs font-semibold text-[#28180d]"
   182	              : "inline-flex items-center rounded-full border-2 border-[#141026] bg-[#6bf0d2] px-3.5 py-1 text-xs font-bold text-[#141026] shadow-[2px_2px_0px_#141026]"
   183	          }
   184	        >
   185	          全{items.length}問・排他開閉
   186	        </span>
   187	      </div>
   188	
   189	      <div className="faq-list flex flex-col gap-4">
   190	        {items.map((item, index) => {
   191	          const qNumber = index + 1;
   192	          const detailsDomId = `${instanceId}-${item.id}`;
   193	          const summaryDomId = `${instanceId}-${item.id}-summary`;
   194	
