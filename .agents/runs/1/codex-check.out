    40	              name="fallback-preview-faq"
    41	              className="faq-details faq-card rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] text-[#28180d] shadow-[4px_4px_0px_#3a2212]"
    42	            >
    43	              <summary className="flex min-h-[56px] cursor-pointer items-center justify-between gap-3 p-4 sm:p-5">
