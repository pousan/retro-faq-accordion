"use client";

import { useCallback, useEffect, useRef, useState } from "react";

export interface StickyShareBarState {
  hiddenByScroll: boolean;
  hiddenByKeyboard: boolean;
  hiddenAboveViewport: boolean;
  footerOverlap: number;
  barHeight: number;
  hasFocusWithin: boolean;
}

const DIRECTION_THRESHOLD_PX = 12;
const TOP_REVEAL_THRESHOLD_PX = 24;
const KEYBOARD_HEIGHT_THRESHOLD_PX = 140;

export function useStickyShareBar(footerId: string) {
  const barRef = useRef<HTMLElement | null>(null);
  const [state, setState] = useState<StickyShareBarState>({
    hiddenByScroll: false,
    hiddenByKeyboard: false,
    hiddenAboveViewport: false,
    footerOverlap: 0,
    barHeight: 72,
    hasFocusWithin: false,
  });

  const lastScrollYRef = useRef<number>(0);
  const directionRef = useRef<"up" | "down" | null>(null);
  const accumulatedDeltaRef = useRef<number>(0);
  const footerNearRef = useRef<boolean>(false);
  const hasFocusWithinRef = useRef<boolean>(false);
  const rafIdRef = useRef<number | null>(null);

  const updateStateIfChanged = useCallback(
    (partial: Partial<StickyShareBarState>) => {
      setState((prev) => {
        let changed = false;
        const next: StickyShareBarState = { ...prev };
        (Object.keys(partial) as Array<keyof StickyShareBarState>).forEach(
          (key) => {
            const val = partial[key];
            if (val !== undefined && prev[key] !== val) {
              // eslint-disable-next-line @typescript-eslint/no-explicit-any
              (next as any)[key] = val;
              changed = true;
            }
          }
        );
        return changed ? next : prev;
      });
    },
    []
  );

  const handleFocusIn = useCallback(() => {
    hasFocusWithinRef.current = true;
    updateStateIfChanged({
      hasFocusWithin: true,
      hiddenByScroll: false,
      hiddenByKeyboard: false,
    });
  }, [updateStateIfChanged]);

  const handleFocusOut = useCallback(
    (event: React.FocusEvent<HTMLElement>) => {
      const currentTarget = event.currentTarget;
      const relatedTarget = event.relatedTarget as Node | null;
      if (relatedTarget && currentTarget.contains(relatedTarget)) {
        return;
      }
      hasFocusWithinRef.current = false;
      updateStateIfChanged({
        hasFocusWithin: false,
      });
    },
    [updateStateIfChanged]
  );

  useEffect(() => {
    if (typeof window === "undefined") {
      return;
    }

    lastScrollYRef.current = Math.max(0, window.scrollY);

    const measureAndSync = () => {
      rafIdRef.current = null;

      const currentScrollY = Math.max(0, window.scrollY);
      const delta = currentScrollY - lastScrollYRef.current;
      lastScrollYRef.current = currentScrollY;

      let nextHiddenByScroll: boolean | undefined = undefined;

      if (currentScrollY <= TOP_REVEAL_THRESHOLD_PX) {
        directionRef.current = "up";
        accumulatedDeltaRef.current = 0;
        nextHiddenByScroll = false;
      } else if (delta !== 0) {
        const currentDirection: "up" | "down" = delta > 0 ? "down" : "up";
        if (directionRef.current !== currentDirection) {
          directionRef.current = currentDirection;
          accumulatedDeltaRef.current = Math.abs(delta);
        } else {
          accumulatedDeltaRef.current += Math.abs(delta);
        }

        if (accumulatedDeltaRef.current >= DIRECTION_THRESHOLD_PX) {
          if (currentDirection === "down" && !hasFocusWithinRef.current) {
            nextHiddenByScroll = true;
          } else if (currentDirection === "up") {
            nextHiddenByScroll = false;
          }
        }
      }

      if (hasFocusWithinRef.current) {
        nextHiddenByScroll = false;
      }

      let nextFooterOverlap = 0;
      let nextHiddenAboveViewport = false;
      const footerEl = document.getElementById(footerId);

      if (footerEl) {
        const footerRect = footerEl.getBoundingClientRect();
        const viewportBottom = window.innerHeight;
        if (footerRect.top < viewportBottom) {
          footerNearRef.current = true;
        }
        if (footerNearRef.current) {
          const overlap = Math.max(
            0,
            Math.round(viewportBottom - footerRect.top)
          );
          nextFooterOverlap = overlap;
          const barH = barRef.current?.offsetHeight ?? 72;
          if (footerRect.top <= barH && !hasFocusWithinRef.current) {
            nextHiddenAboveViewport = true;
          }
        }
      }

      let nextHiddenByKeyboard = false;
      if (window.visualViewport && !hasFocusWithinRef.current) {
        const keyboardDiff =
          window.innerHeight - window.visualViewport.height;
        if (keyboardDiff > KEYBOARD_HEIGHT_THRESHOLD_PX) {
          nextHiddenByKeyboard = true;
        }
      }

      const partialUpdate: Partial<StickyShareBarState> = {
        footerOverlap: nextFooterOverlap,
        hiddenAboveViewport: nextHiddenAboveViewport,
        hiddenByKeyboard: nextHiddenByKeyboard,
      };
      if (nextHiddenByScroll !== undefined) {
        partialUpdate.hiddenByScroll = nextHiddenByScroll;
      }

      updateStateIfChanged(partialUpdate);
    };

    const scheduleSync = () => {
      if (rafIdRef.current !== null) {
        return;
      }
      rafIdRef.current = window.requestAnimationFrame(measureAndSync);
    };

    const footerEl = document.getElementById(footerId);
    const sentinelEl =
      document.getElementById(`${footerId}-sentinel`) ?? footerEl;

    let intersectionObserver: IntersectionObserver | null = null;
    if (typeof IntersectionObserver !== "undefined" && sentinelEl) {
      intersectionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            footerNearRef.current =
              entry.isIntersecting ||
              entry.boundingClientRect.top < window.innerHeight;
          }
          scheduleSync();
        },
        {
          root: null,
          rootMargin: "0px 0px 160px 0px",
          threshold: [0, 0.01, 0.5, 1],
        }
      );
      intersectionObserver.observe(sentinelEl);
    }

    let resizeObserver: ResizeObserver | null = null;
    if (typeof ResizeObserver !== "undefined" && barRef.current) {
      resizeObserver = new ResizeObserver((entries) => {
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          const measured = Math.ceil(target.offsetHeight);
          if (measured > 0) {
            updateStateIfChanged({ barHeight: measured });
          }
        }
        scheduleSync();
      });
      resizeObserver.observe(barRef.current);
    }

    window.addEventListener("scroll", scheduleSync, { passive: true });
    window.addEventListener("resize", scheduleSync, { passive: true });

    const vv = window.visualViewport;
    if (vv) {
      vv.addEventListener("resize", scheduleSync, { passive: true });
      vv.addEventListener("scroll", scheduleSync, { passive: true });
    }

    scheduleSync();

    return () => {
      window.removeEventListener("scroll", scheduleSync);
      window.removeEventListener("resize", scheduleSync);
      if (vv) {
        vv.removeEventListener("resize", scheduleSync);
        vv.removeEventListener("scroll", scheduleSync);
      }
      if (intersectionObserver) {
        intersectionObserver.disconnect();
      }
      if (resizeObserver) {
        resizeObserver.disconnect();
      }
      if (rafIdRef.current !== null) {
        window.cancelAnimationFrame(rafIdRef.current);
        rafIdRef.current = null;
      }
    };
  }, [footerId, updateStateIfChanged]);

  const isRetreated =
    !state.hasFocusWithin &&
    (state.hiddenByScroll ||
      state.hiddenByKeyboard ||
      state.hiddenAboveViewport);

  return {
    barRef,
    isRetreated,
    footerOverlap: state.footerOverlap,
    barHeight: state.barHeight,
    handleFocusIn,
    handleFocusOut,
  };
}
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { FAQ_CATEGORY_LABELS } from "@/data/faqs";
import { FaqJsonLd } from "@/components/FaqJsonLd";
import type {
  AccordionFaqProps,
  FaqHighlightMode,
  FaqTheme,
} from "@/lib/faq-types";

const HIGHLIGHT_CLASS_MAP: Readonly<
  Record<FaqTheme, Readonly<Record<FaqHighlightMode, string>>>
> = {
  retro: {
    flash: "animate-flash-retro",
    subtle: "animate-subtle-retro",
  },
  citypop: {
    flash: "animate-flash-citypop",
    subtle: "animate-subtle-citypop",
  },
};

export function AccordionFaq({
  items,
  title = "よくあるご質問",
  instanceId,
  selectedId,
  onOpenChange,
  highlight,
  includeJsonLd = true,
  theme,
}: AccordionFaqProps) {
  const detailsMapRef = useRef<Map<string, HTMLDetailsElement>>(new Map());
  const onOpenChangeRef = useRef<typeof onOpenChange>(onOpenChange);
  const syncingTargetRef = useRef<string | null | undefined>(undefined);
  const toggleRafRef = useRef<number | null>(null);

  const [completedAnimToken, setCompletedAnimToken] = useState<number | null>(
    null
  );

  useEffect(() => {
    onOpenChangeRef.current = onOpenChange;
  }, [onOpenChange]);

  useEffect(() => {
    syncingTargetRef.current = selectedId;

    detailsMapRef.current.forEach((el, itemId) => {
      if (itemId !== selectedId && el.open) {
        el.open = false;
      }
    });

    if (selectedId !== null) {
      const targetEl = detailsMapRef.current.get(selectedId);
      if (targetEl && !targetEl.open) {
        targetEl.open = true;
      }
    }

    const clearSyncRaf = window.requestAnimationFrame(() => {
      syncingTargetRef.current = undefined;
    });

    return () => {
      window.cancelAnimationFrame(clearSyncRaf);
    };
  }, [selectedId, items]);

  useEffect(() => {
    return () => {
      if (toggleRafRef.current !== null) {
        window.cancelAnimationFrame(toggleRafRef.current);
      }
    };
  }, []);

  const setDetailsRef = useCallback(
    (itemId: string) => (node: HTMLDetailsElement | null) => {
      if (node) {
        detailsMapRef.current.set(itemId, node);
      } else {
        detailsMapRef.current.delete(itemId);
      }
    },
    []
  );

  const handleDetailsToggle = useCallback(
    (toggledId: string, event: React.SyntheticEvent<HTMLDetailsElement>) => {
      const toggledElement = event.currentTarget;

      if (toggledElement.open) {
        detailsMapRef.current.forEach((el, id) => {
          if (id !== toggledId && el.open) {
            el.open = false;
          }
        });
      }

      if (toggleRafRef.current !== null) {
        window.cancelAnimationFrame(toggleRafRef.current);
      }

      toggleRafRef.current = window.requestAnimationFrame(() => {
        toggleRafRef.current = null;

        let activeOpenId: string | null = null;
        for (const item of items) {
          const el = detailsMapRef.current.get(item.id);
          if (el?.open) {
            activeOpenId = item.id;
            break;
          }
        }

        if (
          syncingTargetRef.current !== undefined &&
          activeOpenId === syncingTargetRef.current
        ) {
          return;
        }

        onOpenChangeRef.current?.(activeOpenId);
      });
    },
    [items]
  );

  const headingId = `${instanceId}-heading`;
  const groupName = instanceId;
  const isRetro = theme === "retro";

  return (
    <section
      aria-labelledby={headingId}
      data-theme={theme}
      className="w-full"
    >
      <div
        className={
          isRetro
            ? "mb-6 flex flex-wrap items-center justify-between gap-3 border-b-2 border-[#3a2212] pb-4"
            : "mb-6 flex flex-wrap items-center justify-between gap-3 border-b-[3px] border-[#141026] pb-4"
        }
      >
        <div className="flex items-center gap-3">
          {isRetro ? (
            <span
              aria-hidden="true"
              className="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-sm border-2 border-[#a82417] bg-[#a82417] text-sm font-bold tracking-widest text-[#fffdf8] shadow-[2px_2px_0px_#3a2212]"
            >
              問答
            </span>
          ) : (
            <span
              aria-hidden="true"
              className="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-[3px] border-[#141026] bg-[#ff79b4] text-sm font-black text-[#141026] shadow-[3px_3px_0px_#141026]"
            >
              FAQ
            </span>
          )}
          <h2
            id={headingId}
            className={
              isRetro
                ? "text-xl font-bold tracking-wide text-[#28180d] sm:text-2xl"
                : "text-xl font-black tracking-tight text-[#141026] sm:text-2xl"
            }
          >
            {title}
          </h2>
        </div>

        <span
          className={
            isRetro
              ? "inline-flex items-center rounded-xs border border-[#3a2212] bg-[#efe3ca] px-3 py-1 text-xs font-semibold text-[#28180d]"
              : "inline-flex items-center rounded-full border-2 border-[#141026] bg-[#6bf0d2] px-3.5 py-1 text-xs font-bold text-[#141026] shadow-[2px_2px_0px_#141026]"
          }
        >
          全{items.length}問・排他開閉
        </span>
      </div>

      <div className="faq-list flex flex-col gap-4">
        {items.map((item, index) => {
          const qNumber = index + 1;
          const detailsDomId = `${instanceId}-${item.id}`;
          const summaryDomId = `${instanceId}-${item.id}-summary`;

          const isHighlightedItem =
            highlight !== undefined && highlight.id === item.id;
          const shouldPlayAnimation =
            isHighlightedItem && completedAnimToken !== highlight.token;
          const animationClass = shouldPlayAnimation
            ? HIGHLIGHT_CLASS_MAP[theme][highlight.mode]
            : "";
          const isStaticHighlightActive =
            isHighlightedItem && selectedId === item.id;

          const paragraphs = item.answer
            .split("\n")
            .map((line) => line.trim())
            .filter(Boolean);

          return (
            <details
              key={item.id}
              ref={setDetailsRef(item.id)}
              id={detailsDomId}
              name={groupName}
              onToggle={(e) => handleDetailsToggle(item.id, e)}
              className={
                isRetro
                  ? "faq-details faq-card group rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] text-[#28180d] shadow-[4px_4px_0px_#3a2212] open:bg-[#fcf6e8]"
                  : "faq-details faq-card group rounded-3xl border-[3px] border-[#141026] bg-[#ffffff] text-[#141026] shadow-[5px_5px_0px_#141026] open:bg-[#f5fffb]"
              }
            >
              <summary
                id={summaryDomId}
                data-highlight={isStaticHighlightActive ? "active" : undefined}
                onAnimationEnd={() => {
                  if (isHighlightedItem) {
                    setCompletedAnimToken(highlight.token);
                  }
                }}
                className={`faq-summary-highlighted flex min-h-[56px] cursor-pointer select-none items-start justify-between gap-3 p-4 sm:items-center sm:p-5 ${
                  isRetro
                    ? "rounded-sm hover:bg-[#f9f2e2]"
                    : "rounded-3xl hover:bg-[#fff0f7]"
                } ${animationClass}`}
              >
                <span className="flex min-w-0 flex-1 items-start gap-3 sm:items-center">
                  <span
                    aria-hidden="true"
                    className={
                      isRetro
                        ? "faq-q-badge inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xs border-2 border-[#3a2212] bg-[#a82417] text-sm font-bold text-[#fffdf8] shadow-[2px_2px_0px_#3a2212]"
                        : "faq-q-badge inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 border-[#141026] bg-[#ff79b4] text-sm font-black text-[#141026] shadow-[2px_2px_0px_#141026]"
                    }
                  >
                    Q{qNumber}
                  </span>

                  <span className="flex min-w-0 flex-1 flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
                    <span className="break-words text-base font-bold leading-snug sm:text-lg">
                      {item.question}
                    </span>
                    <span
                      className={
                        isRetro
                          ? "faq-category-badge inline-flex w-fit shrink-0 items-center rounded-xs border border-[#3a2212] bg-[#efe3ca] px-2.5 py-0.5 text-xs font-semibold text-[#28180d]"
                          : "faq-category-badge inline-flex w-fit shrink-0 items-center rounded-full border-2 border-[#141026] bg-[#6bf0d2] px-2.5 py-0.5 text-xs font-bold text-[#141026]"
                      }
                    >
                      {FAQ_CATEGORY_LABELS[item.category]}
                    </span>
                  </span>
                </span>

                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth={2.5}
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  className="faq-chevron mt-1 h-6 w-6 shrink-0 text-current sm:mt-0"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </summary>

              <div
                className={
                  isRetro
                    ? "faq-answer border-t-2 border-dashed border-[#3a2212] px-4 pb-5 pt-4 sm:px-6"
                    : "faq-answer border-t-[3px] border-[#141026] px-4 pb-5 pt-4 sm:px-6"
                }
              >
                <div className="flex items-start gap-3">
                  <span
                    aria-hidden="true"
                    className={
                      isRetro
                        ? "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-xs border border-[#3a2212] bg-[#efe3ca] text-xs font-bold text-[#28180d]"
                        : "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-[#141026] bg-[#6bf0d2] text-xs font-black text-[#141026]"
                    }
                  >
                    A
                  </span>
                  <div className="min-w-0 flex-1 space-y-2 break-words text-sm leading-relaxed sm:text-base">
                    {paragraphs.map((paragraph, pIdx) => (
                      <p key={pIdx}>{paragraph}</p>
                    ))}
                  </div>
                </div>
              </div>
            </details>
          );
        })}
      </div>

      {includeJsonLd ? (
        <FaqJsonLd items={items} scriptId={`${instanceId}-jsonld`} />
      ) : null}
    </section>
  );
}
"use client";

import { useEffect } from "react";
import { AccordionFaq } from "@/components/AccordionFaq";
import { MobileStickyShareBar } from "@/components/MobileStickyShareBar";
import { ShareButtonGroup } from "@/components/ShareButtonGroup";
import { useFaqQuerySync } from "@/hooks/useFaqQuerySync";
import type { FaqItem, FaqTheme } from "@/lib/faq-types";

export interface FaqPreviewClientProps {
  items: readonly FaqItem[];
  instanceId?: string;
  footerId: string;
}

const THEME_OPTIONS: ReadonlyArray<{
  value: FaqTheme;
  label: string;
  sublabel: string;
  badgeText: string;
}> = [
  {
    value: "retro",
    label: "昭和純喫茶・和レトロ",
    sublabel: "生成り紙・濃茶文字・朱色落款印・明朝体・ソリッド影",
    badgeText: "純喫茶",
  },
  {
    value: "citypop",
    label: "80s シティポップ",
    sublabel: "ホットピンク×ミント・濃色文字・太黒枠・バブル角丸",
    badgeText: "80s POP",
  },
];

export function FaqPreviewClient({
  items,
  instanceId = "preview-faq",
  footerId,
}: FaqPreviewClientProps) {
  const {
    theme,
    selectedId,
    questionIndex,
    highlight,
    shareUrl,
    handleThemeChange,
    handleOpenChange,
  } = useFaqQuerySync(items, instanceId);

  useEffect(() => {
    document.documentElement.setAttribute("data-theme", theme);
  }, [theme]);

  const isRetro = theme === "retro";
  const selectedQuestion = selectedId
    ? items.find((item) => item.id === selectedId) ?? null
    : null;

  const shareTitle = selectedQuestion
    ? `Q${questionIndex}. ${selectedQuestion.question} | Studio Miraie カフェ向けホームページ制作FAQ`
    : "Studio Miraie カフェ向けホームページ制作 よくあるご質問（FAQ）";

  const shareText = selectedQuestion
    ? selectedQuestion.answer
    : "昭和レトロ＆80sシティポップの2スタイルで切り替えられるカフェ向けホームページ制作FAQ";

  return (
    <div data-theme={theme} className="faq-theme-root w-full">
      <div className="mx-auto max-w-4xl space-y-8">
        <div
          className={
            isRetro
              ? "theme-selector-card rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] p-4 shadow-[4px_4px_0px_#3a2212] sm:p-6"
              : "theme-selector-card rounded-3xl border-[3px] border-[#141026] bg-[#ffffff] p-4 shadow-[5px_5px_0px_#141026] sm:p-6"
          }
        >
          <fieldset>
            <legend
              className={
                isRetro
                  ? "mb-3 flex flex-wrap items-center gap-2 text-base font-bold text-[#28180d] sm:text-lg"
                  : "mb-3 flex flex-wrap items-center gap-2 text-base font-black text-[#141026] sm:text-lg"
              }
            >
              <span>デザインテーマ切り替え</span>
              <span
                className={
                  isRetro
                    ? "rounded-xs border border-[#3a2212] bg-[#efe3ca] px-2 py-0.5 text-xs font-semibold text-[#28180d]"
                    : "rounded-full border-2 border-[#141026] bg-[#ffd9ec] px-2.5 py-0.5 text-xs font-bold text-[#141026]"
                }
              >
                URLクエリ ?style={theme}
                {questionIndex ? `&q=${questionIndex}` : ""} と自動同期
              </span>
            </legend>

            <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {THEME_OPTIONS.map((option) => {
                const isSelected = theme === option.value;
                return (
                  <label
                    key={option.value}
                    className={`faq-focusable relative flex min-h-[60px] cursor-pointer items-start gap-3 p-3.5 transition-colors focus-within:outline-3 focus-within:outline-offset-2 ${
                      isRetro
                        ? isSelected
                          ? "rounded-sm border-2 border-[#a82417] bg-[#fcf6e8] text-[#28180d] shadow-[3px_3px_0px_#3a2212]"
                          : "rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] text-[#28180d] hover:bg-[#f9f2e2]"
                        : isSelected
                        ? "rounded-2xl border-[3px] border-[#141026] bg-[#ffd9ec] text-[#141026] shadow-[4px_4px_0px_#141026]"
                        : "rounded-2xl border-2 border-[#141026] bg-[#ffffff] text-[#141026] hover:bg-[#f5fffb]"
                    }`}
                  >
                    <input
                      type="radio"
                      name="faq-theme-style"
                      value={option.value}
                      checked={isSelected}
                      onChange={() => handleThemeChange(option.value)}
                      className="mt-1 h-4 w-4 shrink-0 accent-[#a82417]"
                    />
                    <span className="flex min-w-0 flex-1 flex-col gap-1">
                      <span className="flex flex-wrap items-center justify-between gap-2">
                        <span className="text-sm font-bold sm:text-base">
                          {option.label}
                        </span>
                        <span
                          className={
                            isSelected
                              ? isRetro
                                ? "inline-flex items-center gap-1 rounded-xs border border-[#3a2212] bg-[#a82417] px-2 py-0.5 text-xs font-bold text-[#fffdf8]"
                                : "inline-flex items-center gap-1 rounded-full border-2 border-[#141026] bg-[#6bf0d2] px-2.5 py-0.5 text-xs font-black text-[#141026]"
                              : "inline-flex items-center rounded-xs border border-current/40 px-2 py-0.5 text-xs font-medium opacity-75"
                          }
                        >
                          {isSelected
                            ? `● 選択中 (${option.badgeText})`
                            : option.badgeText}
                        </span>
                      </span>
                      <span className="text-xs leading-relaxed opacity-85">
                        {option.sublabel}
                      </span>
                    </span>
                  </label>
                );
              })}
            </div>
          </fieldset>
        </div>

        <AccordionFaq
          items={items}
          title="カフェ向けホームページ制作 よくあるご質問"
          instanceId={instanceId}
          selectedId={selectedId}
          onOpenChange={handleOpenChange}
          highlight={highlight}
          includeJsonLd={true}
          theme={theme}
        />

        <section
          aria-labelledby="inline-share-heading"
          className={
            isRetro
              ? "faq-card rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] p-4 shadow-[4px_4px_0px_#3a2212] sm:p-6"
              : "faq-card rounded-3xl border-[3px] border-[#141026] bg-[#ffffff] p-4 shadow-[5px_5px_0px_#141026] sm:p-6"
          }
        >
          <div className="mb-3 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
            <h2
              id="inline-share-heading"
              className="text-base font-bold sm:text-lg"
            >
              このFAQ表示を共有する
            </h2>
            <p className="text-xs opacity-85">
              {selectedQuestion
                ? `現在選択中の「Q${questionIndex}. ${selectedQuestion.question}」への直リンクを共有します`
                : `現在のテーマ（${
                    isRetro ? "昭和純喫茶・和レトロ" : "80s シティポップ"
                  }）のFAQ一覧リンクを共有します`}
            </p>
          </div>

          <ShareButtonGroup
            url={shareUrl}
            title={shareTitle}
            text={shareText}
            theme={theme}
            statusIdPrefix="inline-share"
          />
        </section>
      </div>

      <MobileStickyShareBar
        url={shareUrl}
        title={shareTitle}
        text={shareText}
        theme={theme}
        footerId={footerId}
      />
    </div>
  );
}

export default FaqPreviewClient;

