     1	import type {
     2	  FaqItem,
     3	  FaqQueryParseResult,
     4	  FaqTheme,
     5	} from "@/lib/faq-types";
     6	
     7	export interface SearchParamsLike {
     8	  getAll(name: string): string[];
     9	}
    10	
    11	const POSITIVE_INTEGER_PATTERN = /^[1-9]\d*$/;
    12	
    13	export function isValidFaqTheme(value: string | null | undefined): value is FaqTheme {
    14	  return value === "retro" || value === "citypop";
    15	}
    16	
    17	export function getQuestionNumberById(
    18	  items: readonly FaqItem[],
    19	  selectedId: string | null
    20	): number | null {
    21	  if (!selectedId) {
    22	    return null;
    23	  }
    24	  const index = items.findIndex((item) => item.id === selectedId);
    25	  return index >= 0 ? index + 1 : null;
    26	}
    27	
    28	export function parseFaqQuery(
    29	  searchParams: SearchParamsLike,
    30	  items: readonly FaqItem[]
    31	): FaqQueryParseResult {
    32	  const styleValues = searchParams.getAll("style");
    33	  const rawStyle = styleValues.length === 1 ? styleValues[0] : null;
    34	  const theme: FaqTheme = isValidFaqTheme(rawStyle) ? rawStyle : "retro";
    35	
    36	  const qValues = searchParams.getAll("q");
    37	  if (qValues.length !== 1) {
    38	    return {
    39	      theme,
    40	      selectedId: null,
    41	      validExplicitQuestion: false,
    42	      questionIndex: null,
    43	    };
    44	  }
    45	
    46	  const rawQ = qValues[0];
    47	  if (!POSITIVE_INTEGER_PATTERN.test(rawQ)) {
    48	    return {
    49	      theme,
    50	      selectedId: null,
    51	      validExplicitQuestion: false,
    52	      questionIndex: null,
    53	    };
    54	  }
    55	
    56	  const parsedNumber = Number(rawQ);
    57	  if (
    58	    !Number.isSafeInteger(parsedNumber) ||
    59	    parsedNumber < 1 ||
    60	    parsedNumber > items.length
    61	  ) {
    62	    return {
    63	      theme,
    64	      selectedId: null,
    65	      validExplicitQuestion: false,
    66	      questionIndex: null,
    67	    };
    68	  }
    69	
    70	  const targetItem = items[parsedNumber - 1];
    71	  if (!targetItem) {
    72	    return {
    73	      theme,
    74	      selectedId: null,
    75	      validExplicitQuestion: false,
    76	      questionIndex: null,
    77	    };
    78	  }
    79	
    80	  return {
    81	    theme,
    82	    selectedId: targetItem.id,
    83	    validExplicitQuestion: true,
    84	    questionIndex: parsedNumber,
    85	  };
    86	}
    87	
    88	export function buildNextRelativeUrl(
    89	  currentHref: string,
    90	  nextState: {
    91	    theme: FaqTheme;
    92	    selectedId: string | null;
    93	  },
    94	  items: readonly FaqItem[]
    95	): string {
