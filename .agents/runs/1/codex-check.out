    61	    ? `Q${questionIndex}. ${selectedQuestion.question} | Studio Miraie カフェ向けホームページ制作FAQ`
    62	    : "Studio Miraie カフェ向けホームページ制作 よくあるご質問（FAQ）";
    63	
    64	  const shareText = selectedQuestion
    65	    ? selectedQuestion.answer
    66	    : "昭和レトロ＆80sシティポップの2スタイルで切り替えられるカフェ向けホームページ制作FAQ";
    67	
    68	  return (
    69	    <div data-theme={theme} className="faq-theme-root w-full">
    70	      <div className="mx-auto max-w-4xl space-y-8">
    71	        <div
    72	          className={
    73	            isRetro
    74	              ? "theme-selector-card rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] p-4 shadow-[4px_4px_0px_#3a2212] sm:p-6"
    75	              : "theme-selector-card rounded-3xl border-[3px] border-[#141026] bg-[#ffffff] p-4 shadow-[5px_5px_0px_#141026] sm:p-6"
    76	          }
    77	        >
    78	          <fieldset>
