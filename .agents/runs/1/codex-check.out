   161	    overflow: clip;
   162	    transition-property: block-size, opacity, content-visibility;
   163	    transition-duration: 240ms, 200ms, 240ms;
   164	    transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1), ease, linear;
   165	    transition-behavior: allow-discrete;
   166	  }
   167	
   168	  .faq-details[open]::details-content {
   169	    block-size: auto;
   170	    opacity: 1;
   171	  }
   172	
   173	  @starting-style {
   174	    .faq-details[open]::details-content {
   175	      block-size: 0;
   176	      opacity: 0;
   177	    }
   178	  }
   179	}
   180	
   181	/* 2-round-trip (2 iterations) flash animations for initial deep-link arrival */
   182	@keyframes faq-flash-retro {
   183	  0%,
   184	  100% {
   185	    background-color: var(--color-retro-surface);
   186	    box-shadow: 0 0 0 0 rgba(168, 36, 23, 0);
   187	  }
   188	  50% {
   189	    background-color: var(--color-retro-vermilion-soft);
   190	    box-shadow: 0 0 0 4px var(--color-retro-vermilion);
   191	  }
   192	}
   193	
   194	@keyframes faq-flash-citypop {
   195	  0%,
   196	  100% {
   197	    background-color: var(--color-citypop-surface);
   198	    box-shadow: 0 0 0 0 rgba(255, 121, 180, 0);
   199	  }
   200	  50% {
   201	    background-color: var(--color-citypop-yellow);
   202	    box-shadow: 0 0 0 5px var(--color-citypop-pink);
   203	  }
   204	}
   205	
   206	/* 1-pulse subtle animations for user toggle open */
   207	@keyframes faq-subtle-retro {
   208	  0%,
   209	  100% {
   210	    box-shadow: 0 0 0 0 rgba(168, 36, 23, 0);
   211	  }
   212	  50% {
   213	    box-shadow: 0 0 0 4px rgba(168, 36, 23, 0.65);
   214	  }
   215	}
   216	
   217	@keyframes faq-subtle-citypop {
   218	  0%,
   219	  100% {
   220	    box-shadow: 0 0 0 0 rgba(107, 240, 210, 0);
   221	  }
   222	  50% {
   223	    box-shadow: 0 0 0 5px var(--color-citypop-mint);
   224	  }
   225	}
   226	
   227	.animate-flash-retro {
   228	  animation: faq-flash-retro 800ms ease-in-out 2;
   229	}
   230	
   231	.animate-flash-citypop {
   232	  animation: faq-flash-citypop 800ms ease-in-out 2;
   233	}
   234	
   235	.animate-subtle-retro {
   236	  animation: faq-subtle-retro 500ms ease-out 1;
   237	}
   238	
   239	.animate-subtle-citypop {
   240	  animation: faq-subtle-citypop 500ms ease-out 1;
   241	}
   242	
   243	/* Sticky bar transition */
   244	.sticky-share-bar {
   245	  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
   246	    visibility 220ms linear;
   247	}
   248	
   249	/* Windows High Contrast / Forced Colors Mode */
   250	@media (forced-colors: active) {
   251	  .faq-theme-root,
   252	  .faq-card,
   253	  .faq-details,
   254	  .faq-details > summary,
   255	  .sticky-share-bar,
   256	  .theme-selector-card {
   257	    forced-color-adjust: auto;
   258	    background-image: none !important;
   259	    background-color: Canvas !important;
   260	    color: CanvasText !important;
   261	    border-color: CanvasText !important;
   262	    box-shadow: none !important;
   263	  }
   264	
   265	  .faq-details[open] {
   266	    border-color: Highlight !important;
   267	  }
   268	
   269	  .faq-details[open] > summary {
   270	    border-bottom: 2px solid Highlight !important;
   271	  }
   272	
   273	  .faq-q-badge,
   274	  .faq-category-badge {
   275	    background-color: Canvas !important;
   276	    color: ButtonText !important;
   277	    border: 2px solid ButtonText !important;
   278	  }
   279	
   280	  .faq-details > summary:focus-visible,
   281	  .faq-focusable:focus-visible {
   282	    outline: 3px solid Highlight !important;
   283	    outline-offset: 3px !important;
   284	  }
   285	}
   286	
   287	/* Reduced Motion preference (placed last to override animations/transitions) */
   288	@media (prefers-reduced-motion: reduce) {
   289	  html,
   290	  body {
   291	    scroll-behavior: auto !important;
   292	  }
   293	
   294	  .faq-chevron,
   295	  .sticky-share-bar,
   296	  .faq-details::details-content {
   297	    transition: none !important;
   298	  }
   299	
   300	  .animate-flash-retro,
   301	  .animate-flash-citypop,
   302	  .animate-subtle-retro,
   303	  .animate-subtle-citypop {
   304	    animation: none !important;
   305	  }
   306	
   307	  .faq-summary-highlighted[data-highlight="active"] {
   308	    outline: 3px dashed var(--faq-focus-ring);
   309	    outline-offset: -4px;
   310	  }
   311	}
