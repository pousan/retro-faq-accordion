FILE: components/ShareButtonGroup.tsx
     1	"use client";
     2	
     3	import { useCallback, useEffect, useId, useRef, useState } from "react";
     4	import {
     5	  attemptNativeShare,
     6	  buildLineShareUrl,
     7	  buildXIntentUrl,
     8	  copyToClipboard,
     9	} from "@/lib/share";
    10	import type { ShareButtonGroupProps, ShareStatus } from "@/lib/faq-types";
    11	
    12	export function ShareButtonGroup({
    13	  url,
    14	  title,
    15	  text,
    16	  theme,
    17	  compact = false,
    18	  statusIdPrefix,
    19	}: ShareButtonGroupProps) {
    20	  const reactId = useId();
    21	  const baseId = statusIdPrefix ? `${statusIdPrefix}-${reactId}` : reactId;
    22	  const statusId = `${baseId}-share-status`;
    23	  const manualInputId = `${baseId}-manual-url`;
    24	
    25	  const [status, setStatus] = useState<ShareStatus>("idle");
    26	  const [message, setMessage] = useState<string>("");
    27	  const [isBusy, setIsBusy] = useState<boolean>(false);
    28	  const [showManualCopy, setShowManualCopy] = useState<boolean>(false);
    29	
    30	  const manualInputRef = useRef<HTMLInputElement | null>(null);
    31	  const resetTimerRef = useRef<number | null>(null);
    32	
    33	  const clearResetTimer = useCallback(() => {
    34	    if (resetTimerRef.current !== null) {
    35	      window.clearTimeout(resetTimerRef.current);
    36	      resetTimerRef.current = null;
    37	    }
    38	  }, []);
    39	
    40	  const scheduleIdleReset = useCallback(() => {
    41	    clearResetTimer();
    42	    resetTimerRef.current = window.setTimeout(() => {
    43	      setStatus("idle");
    44	      setMessage("");
    45	    }, 4000);
    46	  }, [clearResetTimer]);
    47	
    48	  useEffect(() => {
    49	    return () => {
    50	      clearResetTimer();
    51	    };
    52	  }, [clearResetTimer]);
    53	
    54	  useEffect(() => {
    55	    setShowManualCopy(false);
    56	    setStatus("idle");
    57	    setMessage("");
    58	  }, [url]);
    59	
    60	  useEffect(() => {
    61	    if (showManualCopy && manualInputRef.current) {
    62	      manualInputRef.current.focus();
    63	      manualInputRef.current.select();
    64	    }
    65	  }, [showManualCopy]);
    66	
    67	  const handleCopyClick = useCallback(async () => {
    68	    if (!url || isBusy) {
    69	      return;
    70	    }
    71	    clearResetTimer();
    72	    setIsBusy(true);
    73	
    74	    const copied = await copyToClipboard(url);
    75	    setIsBusy(false);
    76	
    77	    if (copied) {
    78	      setShowManualCopy(false);
    79	      setStatus("copied");
    80	      setMessage("共有URLをクリップボードにコピーしました。");
    81	      scheduleIdleReset();
    82	    } else {
    83	      setShowManualCopy(true);
    84	      setStatus("error");
    85	      setMessage(
    86	        "自動コピーできなかったため、下のURL欄を選択して手動でコピーしてください。"
    87	      );
    88	    }
    89	  }, [clearResetTimer, isBusy, scheduleIdleReset, url]);
    90	
    91	  const handleNativeShareClick = useCallback(async () => {
    92	    if (!url || isBusy) {
    93	      return;
    94	    }
    95	    clearResetTimer();
    96	    setIsBusy(true);
    97	    setStatus("sharing");
    98	    setMessage("共有メニューを開いています…");
    99	
   100	    const outcome = await attemptNativeShare({
   101	      title,
   102	      text,
   103	      url,
