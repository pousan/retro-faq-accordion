    54	  useEffect(() => {
    55	    if (initialNavHandledRef.current) {
    56	      return;
    57	    }
    58	
    59	    const markUserInteracted = () => {
    60	      userInteractedBeforeNavRef.current = true;
    61	    };
    62	
    63	    window.addEventListener("keydown", markUserInteracted, {
    64	      passive: true,
    65	      once: true,
    66	    });
    67	    window.addEventListener("pointerdown", markUserInteracted, {
    68	      passive: true,
    69	      once: true,
    70	    });
    71	    window.addEventListener("wheel", markUserInteracted, {
    72	      passive: true,
    73	      once: true,
    74	    });
    75	    window.addEventListener("touchmove", markUserInteracted, {
    76	      passive: true,
    77	      once: true,
    78	    });
