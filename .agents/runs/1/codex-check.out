    84	export async function copyToClipboard(text: string): Promise<boolean> {
    85	  if (
    86	    typeof navigator === "undefined" ||
    87	    typeof window === "undefined" ||
    88	    !window.isSecureContext ||
    89	    !navigator.clipboard ||
    90	    typeof navigator.clipboard.writeText !== "function"
    91	  ) {
    92	    return false;
    93	  }
    94	
    95	  try {
    96	    await navigator.clipboard.writeText(text);
    97	    return true;
    98	  } catch {
    99	    return false;
   100	  }
   101	}
