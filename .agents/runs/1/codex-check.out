    42	export type WebShareOutcome =
    43	  | "shared"
    44	  | "aborted"
    45	  | "unsupported"
    46	  | "failed";
    47	
    48	export async function attemptNativeShare(payload: {
    49	  title: string;
    50	  text?: string;
    51	  url: string;
    52	}): Promise<WebShareOutcome> {
    53	  if (typeof navigator === "undefined" || typeof navigator.share !== "function") {
    54	    return "unsupported";
    55	  }
    56	
    57	  const shareData: ShareData = {
    58	    title: payload.title,
    59	    text: payload.text ?? payload.title,
    60	    url: payload.url,
    61	  };
    62	
    63	  if (typeof navigator.canShare === "function") {
    64	    try {
    65	      if (!navigator.canShare(shareData)) {
    66	        return "unsupported";
    67	      }
    68	    } catch {
    69	      return "unsupported";
    70	    }
    71	  }
    72	
    73	  try {
    74	    await navigator.share(shareData);
    75	    return "shared";
    76	  } catch (err) {
    77	    if (err instanceof Error && err.name === "AbortError") {
    78	      return "aborted";
    79	    }
    80	    return "failed";
    81	  }
    82	}
