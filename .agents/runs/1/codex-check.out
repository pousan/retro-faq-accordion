    80	              className={
    81	                isRetro
    82	                  ? "mb-3 flex flex-wrap items-center gap-2 text-base font-bold text-[#28180d] sm:text-lg"
    83	                  : "mb-3 flex flex-wrap items-center gap-2 text-base font-black text-[#141026] sm:text-lg"
    84	              }
    85	            >
    86	              <span>デザインテーマ切り替え</span>
    87	              <span
    88	                className={
    89	                  isRetro
    90	                    ? "rounded-xs border border-[#3a2212] bg-[#efe3ca] px-2 py-0.5 text-xs font-semibold text-[#28180d]"
    91	                    : "rounded-full border-2 border-[#141026] bg-[#ffd9ec] px-2.5 py-0.5 text-xs font-bold text-[#141026]"
    92	                }
    93	              >
    94	                URLクエリ ?style={theme}
    95	                {questionIndex ? `&q=${questionIndex}` : ""} と自動同期
    96	              </span>
    97	            </legend>
    98	
    99	            <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
   100	              {THEME_OPTIONS.map((option) => {
   101	                const isSelected = theme === option.value;
   102	                return (
   103	                  <label
   104	                    key={option.value}
   105	                    className={`faq-focusable relative flex min-h-[60px] cursor-pointer items-start gap-3 p-3.5 transition-colors focus-within:outline-3 focus-within:outline-offset-2 ${
   106	                      isRetro
   107	                        ? isSelected
   108	                          ? "rounded-sm border-2 border-[#a82417] bg-[#fcf6e8] text-[#28180d] shadow-[3px_3px_0px_#3a2212]"
   109	                          : "rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] text-[#28180d] hover:bg-[#f9f2e2]"
   110	                        : isSelected
   111	                        ? "rounded-2xl border-[3px] border-[#141026] bg-[#ffd9ec] text-[#141026] shadow-[4px_4px_0px_#141026]"
   112	                        : "rounded-2xl border-2 border-[#141026] bg-[#ffffff] text-[#141026] hover:bg-[#f5fffb]"
   113	                    }`}
   114	                  >
   115	                    <input
   116	                      type="radio"
   117	                      name="faq-theme-style"
   118	                      value={option.value}
   119	                      checked={isSelected}
   120	                      onChange={() => handleThemeChange(option.value)}
   121	                      className="mt-1 h-4 w-4 shrink-0 accent-[#a82417]"
   122	                    />
   123	                    <span className="flex min-w-0 flex-1 flex-col gap-1">
   124	                      <span className="flex flex-wrap items-center justify-between gap-2">
   125	                        <span className="text-sm font-bold sm:text-base">
   126	                          {option.label}
   127	                        </span>
   128	                        <span
   129	                          className={
