    80	    let rafId1: number | null = null;
    81	    let rafId2: number | null = null;
    82	    let correctionTimeoutId: number | null = null;
    83	
    84	    if (!validExplicitQuestion || !selectedId) {
    85	      initialNavHandledRef.current = true;
    86	    } else {
    87	      const targetId = selectedId;
    88	      initialNavHandledRef.current = true;
    89	
    90	      tokenRef.current += 1;
    91	      setHighlight({
    92	        id: targetId,
    93	        mode: "flash",
    94	        token: tokenRef.current,
    95	      });
    96	
    97	      rafId1 = window.requestAnimationFrame(() => {
    98	        rafId2 = window.requestAnimationFrame(() => {
    99	          if (userInteractedBeforeNavRef.current) {
   100	            return;
   101	          }
   102	
   103	          const detailsEl = document.getElementById(
   104	            `${instanceId}-${targetId}`
   105	          ) as HTMLDetailsElement | null;
   106	          const summaryEl = document.getElementById(
   107	            `${instanceId}-${targetId}-summary`
   108	          ) as HTMLElement | null;
   109	
   110	          if (!summaryEl) {
   111	            return;
   112	          }
   113	
   114	          if (detailsEl && !detailsEl.open) {
   115	            detailsEl.open = true;
   116	          }
   117	
   118	          const prefersReducedMotion = window.matchMedia(
   119	            "(prefers-reduced-motion: reduce)"
   120	          ).matches;
   121	          const scrollBehavior: ScrollBehavior = prefersReducedMotion
   122	            ? "auto"
   123	            : "smooth";
   124	
   125	          summaryEl.focus({ preventScroll: true });
   126	          summaryEl.scrollIntoView({
   127	            behavior: scrollBehavior,
   128	            block: "start",
   129	          });
   130	
   131	          if (!prefersReducedMotion) {
   132	            correctionTimeoutId = window.setTimeout(() => {
   133	              if (userInteractedBeforeNavRef.current) {
   134	                return;
   135	              }
   136	              const rect = summaryEl.getBoundingClientRect();
   137	              if (rect.top < 0 || rect.top > window.innerHeight * 0.45) {
   138	                summaryEl.scrollIntoView({
   139	                  behavior: "smooth",
   140	                  block: "start",
   141	                });
   142	              }
   143	            }, 280);
   144	          }
   145	        });
   146	      });
   147	    }
   148	
   149	    return () => {
   150	      window.removeEventListener("keydown", markUserInteracted);
   151	      window.removeEventListener("pointerdown", markUserInteracted);
   152	      window.removeEventListener("wheel", markUserInteracted);
   153	      window.removeEventListener("touchmove", markUserInteracted);
   154	      if (rafId1 !== null) {
   155	        window.cancelAnimationFrame(rafId1);
   156	      }
   157	      if (rafId2 !== null) {
   158	        window.cancelAnimationFrame(rafId2);
   159	      }
   160	      if (correctionTimeoutId !== null) {
   161	        window.clearTimeout(correctionTimeoutId);
   162	      }
   163	    };
   164	  }, [instanceId, selectedId, validExplicitQuestion]);
   165	
   166	  const replaceUrlIfChanged = useCallback(
   167	    (nextTheme: FaqTheme, nextSelectedId: string | null) => {
   168	      if (typeof window === "undefined") {
   169	        return;
   170	      }
   171	      const currentRelative = `${window.location.pathname}${window.location.search}${window.location.hash}`;
   172	      const nextRelative = buildNextRelativeUrl(
   173	        window.location.href,
   174	        {
   175	          theme: nextTheme,
   176	          selectedId: nextSelectedId,
   177	        },
   178	        items
   179	      );
   180	
   181	      if (nextRelative !== currentRelative) {
   182	        window.history.replaceState(null, "", nextRelative);
   183	      }
   184	    },
   185	    [items]
   186	  );
   187	
   188	  const handleThemeChange = useCallback(
   189	    (nextTheme: FaqTheme) => {
   190	      userInteractedBeforeNavRef.current = true;
   191	      replaceUrlIfChanged(nextTheme, selectedId);
   192	    },
   193	    [replaceUrlIfChanged, selectedId]
   194	  );
   195	
   196	  const handleOpenChange = useCallback(
   197	    (nextSelectedId: string | null) => {
   198	      userInteractedBeforeNavRef.current = true;
   199	
   200	      if (nextSelectedId !== null && nextSelectedId !== selectedId) {
   201	        tokenRef.current += 1;
   202	        setHighlight({
   203	          id: nextSelectedId,
   204	          mode: "subtle",
   205	          token: tokenRef.current,
   206	        });
   207	      } else if (nextSelectedId === null) {
   208	        setHighlight(undefined);
   209	      }
   210	
   211	      replaceUrlIfChanged(theme, nextSelectedId);
   212	    },
   213	    [replaceUrlIfChanged, selectedId, theme]
   214	  );
   215	
   216	  const shareUrl = useMemo(() => {
   217	    if (!origin) {
   218	      return null;
   219	    }
   220	    return buildCleanShareUrl({
   221	      origin,
   222	      pathname,
   223	      theme,
   224	      selectedId,
   225	      items,
   226	    });
   227	  }, [origin, pathname, theme, selectedId, items]);
   228	
   229	  return {
   230	    theme,
   231	    selectedId,
   232	    validExplicitQuestion,
   233	    questionIndex,
   234	    highlight,
   235	    shareUrl,
   236	    handleThemeChange,
   237	    handleOpenChange,
   238	  };
   239	}
