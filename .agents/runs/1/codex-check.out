   196	            highlight !== undefined && highlight.id === item.id;
   197	          const shouldPlayAnimation =
   198	            isHighlightedItem && completedAnimToken !== highlight.token;
   199	          const animationClass = shouldPlayAnimation
   200	            ? HIGHLIGHT_CLASS_MAP[theme][highlight.mode]
   201	            : "";
   202	          const isStaticHighlightActive =
   203	            isHighlightedItem && selectedId === item.id;
   204	
   205	          const paragraphs = item.answer
   206	            .split("\n")
   207	            .map((line) => line.trim())
   208	            .filter(Boolean);
   209	
   210	          return (
   211	            <details
   212	              key={item.id}
   213	              ref={setDetailsRef(item.id)}
   214	              id={detailsDomId}
   215	              name={groupName}
   216	              onToggle={(e) => handleDetailsToggle(item.id, e)}
   217	              className={
   218	                isRetro
   219	                  ? "faq-details faq-card group rounded-sm border-2 border-[#3a2212] bg-[#fffdf8] text-[#28180d] shadow-[4px_4px_0px_#3a2212] open:bg-[#fcf6e8]"
   220	                  : "faq-details faq-card group rounded-3xl border-[3px] border-[#141026] bg-[#ffffff] text-[#141026] shadow-[5px_5px_0px_#141026] open:bg-[#f5fffb]"
   221	              }
   222	            >
   223	              <summary
   224	                id={summaryDomId}
   225	                data-highlight={isStaticHighlightActive ? "active" : undefined}
   226	                onAnimationEnd={() => {
   227	                  if (isHighlightedItem) {
   228	                    setCompletedAnimToken(highlight.token);
   229	                  }
   230	                }}
   231	                className={`faq-summary-highlighted flex min-h-[56px] cursor-pointer select-none items-start justify-between gap-3 p-4 sm:items-center sm:p-5 ${
   232	                  isRetro
   233	                    ? "rounded-sm hover:bg-[#f9f2e2]"
   234	                    : "rounded-3xl hover:bg-[#fff0f7]"
   235	                } ${animationClass}`}
   236	              >
   237	                <span className="flex min-w-0 flex-1 items-start gap-3 sm:items-center">
   238	                  <span
   239	                    aria-hidden="true"
   240	                    className={
   241	                      isRetro
   242	                        ? "faq-q-badge inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xs border-2 border-[#3a2212] bg-[#a82417] text-sm font-bold text-[#fffdf8] shadow-[2px_2px_0px_#3a2212]"
   243	                        : "faq-q-badge inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 border-[#141026] bg-[#ff79b4] text-sm font-black text-[#141026] shadow-[2px_2px_0px_#141026]"
   244	                    }
   245	                  >
   246	                    Q{qNumber}
   247	                  </span>
   248	
   249	                  <span className="flex min-w-0 flex-1 flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
   250	                    <span className="break-words text-base font-bold leading-snug sm:text-lg">
   251	                      {item.question}
   252	                    </span>
   253	                    <span
   254	                      className={
   255	                        isRetro
   256	                          ? "faq-category-badge inline-flex w-fit shrink-0 items-center rounded-xs border border-[#3a2212] bg-[#efe3ca] px-2.5 py-0.5 text-xs font-semibold text-[#28180d]"
   257	                          : "faq-category-badge inline-flex w-fit shrink-0 items-center rounded-full border-2 border-[#141026] bg-[#6bf0d2] px-2.5 py-0.5 text-xs font-bold text-[#141026]"
   258	                      }
   259	                    >
   260	                      {FAQ_CATEGORY_LABELS[item.category]}
   261	                    </span>
   262	                  </span>
   263	                </span>
   264	
   265	                <svg
   266	                  aria-hidden="true"
   267	                  viewBox="0 0 24 24"
   268	                  fill="none"
   269	                  stroke="currentColor"
   270	                  strokeWidth={2.5}
   271	                  strokeLinecap="round"
   272	                  strokeLinejoin="round"
   273	                  className="faq-chevron mt-1 h-6 w-6 shrink-0 text-current sm:mt-0"
   274	                >
   275	                  <path d="M6 9l6 6 6-6" />
   276	                </svg>
   277	              </summary>
   278	
   279	              <div
   280	                className={
   281	                  isRetro
   282	                    ? "faq-answer border-t-2 border-dashed border-[#3a2212] px-4 pb-5 pt-4 sm:px-6"
   283	                    : "faq-answer border-t-[3px] border-[#141026] px-4 pb-5 pt-4 sm:px-6"
   284	                }
   285	              >
   286	                <div className="flex items-start gap-3">
   287	                  <span
   288	                    aria-hidden="true"
   289	                    className={
   290	                      isRetro
   291	                        ? "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-xs border border-[#3a2212] bg-[#efe3ca] text-xs font-bold text-[#28180d]"
   292	                        : "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-[#141026] bg-[#6bf0d2] text-xs font-black text-[#141026]"
   293	                    }
   294	                  >
   295	                    A
   296	                  </span>
   297	                  <div className="min-w-0 flex-1 space-y-2 break-words text-sm leading-relaxed sm:text-base">
   298	                    {paragraphs.map((paragraph, pIdx) => (
   299	                      <p key={pIdx}>{paragraph}</p>
   300	                    ))}
   301	                  </div>
   302	                </div>
   303	              </div>
   304	            </details>
   305	          );
   306	        })}
   307	      </div>
   308	
   309	      {includeJsonLd ? (
   310	        <FaqJsonLd items={items} scriptId={`${instanceId}-jsonld`} />
   311	      ) : null}
   312	    </section>
   313	  );
   314	}
