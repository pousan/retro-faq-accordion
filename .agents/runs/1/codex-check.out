     3	import { useCallback, useEffect, useRef, useState } from "react";
     4	import { FAQ_CATEGORY_LABELS } from "@/data/faqs";
     5	import { FaqJsonLd } from "@/components/FaqJsonLd";
     6	import type {
     7	  AccordionFaqProps,
     8	  FaqHighlightMode,
     9	  FaqTheme,
    10	} from "@/lib/faq-types";
    11	
    12	const HIGHLIGHT_CLASS_MAP: Readonly<
    13	  Record<FaqTheme, Readonly<Record<FaqHighlightMode, string>>>
    14	> = {
    15	  retro: {
    16	    flash: "animate-flash-retro",
    17	    subtle: "animate-subtle-retro",
    18	  },
    19	  citypop: {
    20	    flash: "animate-flash-citypop",
    21	    subtle: "animate-subtle-citypop",
    22	  },
    23	};
    24	
    25	export function AccordionFaq({
    26	  items,
    27	  title = "よくあるご質問",
    28	  instanceId,
    29	  selectedId,
    30	  onOpenChange,
    31	  highlight,
    32	  includeJsonLd = true,
    33	  theme,
    34	}: AccordionFaqProps) {
    35	  const detailsMapRef = useRef<Map<string, HTMLDetailsElement>>(new Map());
    36	  const onOpenChangeRef = useRef<typeof onOpenChange>(onOpenChange);
    37	  const syncingTargetRef = useRef<string | null | undefined>(undefined);
    38	  const toggleRafRef = useRef<number | null>(null);
    39	
    40	  const [completedAnimToken, setCompletedAnimToken] = useState<number | null>(
    41	    null
    42	  );
    43	
    44	  useEffect(() => {
    45	    onOpenChangeRef.current = onOpenChange;
    46	  }, [onOpenChange]);
    47	
    48	  useEffect(() => {
    49	    syncingTargetRef.current = selectedId;
    50	
    51	    detailsMapRef.current.forEach((el, itemId) => {
    52	      if (itemId !== selectedId && el.open) {
    53	        el.open = false;
    54	      }
    55	    });
    56	
    57	    if (selectedId !== null) {
    58	      const targetEl = detailsMapRef.current.get(selectedId);
    59	      if (targetEl && !targetEl.open) {
    60	        targetEl.open = true;
    61	      }
    62	    }
    63	
    64	    const clearSyncRaf = window.requestAnimationFrame(() => {
    65	      syncingTargetRef.current = undefined;
    66	    });
    67	
    68	    return () => {
    69	      window.cancelAnimationFrame(clearSyncRaf);
    70	    };
    71	  }, [selectedId, items]);
    72	
    73	  useEffect(() => {
    74	    return () => {
    75	      if (toggleRafRef.current !== null) {
    76	        window.cancelAnimationFrame(toggleRafRef.current);
    77	      }
    78	    };
    79	  }, []);
    80	
    81	  const setDetailsRef = useCallback(
    82	    (itemId: string) => (node: HTMLDetailsElement | null) => {
